# ─────────────────────────────────────────────────────────────
# DATABASE — Neon Postgres (production)
# Copy your Neon connection string here. Use the pooled URL and keep ?sslmode=require
# If DATABASE_URL is empty, the app uses a local in-process database (./.pgdata) for dev.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─────────────────────────────────────────────────────────────
# AUTH — session signing secret. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public site origin — used for absolute links in emails / job share URLs.
NEXT_PUBLIC_SITE_URL="https://www.testsoft.com"

# First admin (used by: npm run seed)
SEED_ADMIN_EMAIL="admin@test.com"
SEED_ADMIN_PASSWORD="test!"
SEED_ADMIN_NAME="Admin"

# ─────────────────────────────────────────────────────────────
# EMAIL — SMTP for onboarding announcements (Gmail/Workspace/host).
# If unset, emails are composed but NOT sent (safe for dev).
# Gmail/Workspace example: host=smtp.gmail.com port=587, user=you@domain.com,
# pass = an App Password (not your login password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Testsoft <no-reply@testsoft.com>"
# Optional — where replies should go if different from SMTP_FROM.
SMTP_REPLY_TO=""

# ─────────────────────────────────────────────────────────────
# AI — Google Gemini (email drafting + scoped site chatbot).
# Free key: https://aistudio.google.com/apikey  · If unset, AI features return a friendly 503.
GEMINI_API_KEY=""
